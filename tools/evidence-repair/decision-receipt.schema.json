{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio/evidence-repair/decision-receipt/v1",
  "title": "Review-only evidence repair decision receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "mode", "case_id", "fixture_sha256", "candidate_version", "blocker_version", "playbook", "artifact", "authority", "decision", "approved_scope", "privacy_rights", "sources", "external_action_exclusions", "receipt_sha256"],
  "properties": {
    "schema_version": { "const": "evidence-repair-decision-receipt/v1" },
    "receipt_type": { "const": "approved_evidence_repair_outcome" },
    "mode": { "const": "review_only" },
    "case_id": { "type": "string", "minLength": 1 },
    "fixture_sha256": { "$ref": "#/$defs/hash" },
    "candidate_version": { "type": "string", "minLength": 1 },
    "blocker_version": { "type": "string", "minLength": 1 },
    "playbook": { "type": "string", "minLength": 1 },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["version", "content_path", "content_sha256", "artifact_path", "artifact_sha256", "pr_number", "commit_sha"], "properties": { "version": { "type": "string", "minLength": 1 }, "content_path": { "type": "string", "minLength": 1 }, "content_sha256": { "$ref": "#/$defs/hash" }, "artifact_path": { "type": "string", "minLength": 1 }, "artifact_sha256": { "$ref": "#/$defs/hash" }, "pr_number": { "type": "integer", "minimum": 1 }, "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["reviewer_id", "reviewer_role", "approved_at", "source"], "properties": { "reviewer_id": { "type": "string", "minLength": 1 }, "reviewer_role": { "const": "human_repair_approver" }, "approved_at": { "type": "string", "format": "date-time" }, "source": { "$ref": "#/$defs/source" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["kind", "before", "after", "approved_change", "rollback"], "properties": { "kind": { "const": "approved_repair" }, "before": { "$ref": "#/$defs/meaning" }, "after": { "$ref": "#/$defs/meaning" }, "approved_change": { "type": "object", "minProperties": 1 }, "rollback": { "type": "object", "minProperties": 1 } } },
    "approved_scope": { "type": "object", "additionalProperties": false, "required": ["human_qa_decision", "reviewed_fields", "approved_fields", "exclusions"], "properties": { "human_qa_decision": { "enum": ["passed", "not_required_for_internal_routing"] }, "reviewed_fields": { "$ref": "#/$defs/fields" }, "approved_fields": { "$ref": "#/$defs/fields" }, "exclusions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "privacy_rights": { "type": "object", "additionalProperties": false, "required": ["privacy", "rights", "reviewed_at"], "properties": { "privacy": { "const": "cleared" }, "rights": { "const": "cleared" }, "reviewed_at": { "type": "string", "format": "date-time" } } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "external_action_exclusions": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["provider", "render", "upload", "platform_draft", "schedule", "publish", "external_send", "approval_mutation"] } },
    "receipt_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^(artifacts|tools/evidence-repair)/[a-zA-Z0-9_./-]+$" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "meaning": { "type": "object", "additionalProperties": false, "required": ["meaning_id", "claim_ids"], "properties": { "meaning_id": { "type": "string", "minLength": 1 }, "claim_ids": { "$ref": "#/$defs/fields" } } },
    "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
